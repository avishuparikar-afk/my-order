<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_order_card"
    android:padding="16dp">

    <!-- Vehicle Icon -->
    <ImageView
        android:id="@+id/iv_vehicle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_truck"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Order Title ("Four Wheeler") -->
    <TextView
        android:id="@+id/tv_order_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="Four Wheeler"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/iv_vehicle"
        app:layout_constraintTop_toTopOf="@id/iv_vehicle"
        app:layout_constraintEnd_toStartOf="@id/tv_order_price" />

    <!-- Subtitle (Date, Time, Order ID) -->
    <TextView
        android:id="@+id/tv_order_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="05 Feb, 4:46 PM  |  Order ID: #ORD12345"
        android:textColor="@color/grey_text"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tv_order_title"
        app:layout_constraintTop_toBottomOf="@id/tv_order_title"
        app:layout_constraintEnd_toStartOf="@id/tv_order_price" />

    <!-- Price -->
    <TextView
        android:id="@+id/tv_order_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹ 229.0"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Three Dots Menu Button -->
    <ImageView
        android:id="@+id/btn_menu"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_more_vert"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        app:tint="@color/grey_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_order_price" />

    <!-- Route Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/iv_vehicle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Pickup Icon -->
        <ImageView
            android:id="@+id/iv_pickup_dot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_location_pin"
            app:tint="@color/green_pin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Pickup Address -->
        <TextView
            android:id="@+id/tv_pickup_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="741, Gumanwara"
            android:textColor="@color/black"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/iv_pickup_dot"
            app:layout_constraintTop_toTopOf="@id/iv_pickup_dot"
            app:layout_constraintBottom_toBottomOf="@id/iv_pickup_dot"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Vertical Line connecting dots -->
        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#CCCCCC"
            app:layout_constraintStart_toStartOf="@id/iv_pickup_dot"
            app:layout_constraintEnd_toEndOf="@id/iv_pickup_dot"
            app:layout_constraintTop_toBottomOf="@id/iv_pickup_dot"
            app:layout_constraintBottom_toTopOf="@id/iv_dropoff_dot" />

        <!-- Dropoff Icon -->
        <ImageView
            android:id="@+id/iv_dropoff_dot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_location_pin"
            app:tint="@color/red_pin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_pickup_dot" />

        <!-- Dropoff Address -->
        <TextView
            android:id="@+id/tv_dropoff_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="00, Main Rd, Shivaji Nagar, Jhansi, Uttar Pradesh 284001, India"
            android:textColor="@color/black"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/iv_dropoff_dot"
            app:layout_constraintTop_toTopOf="@id/iv_dropoff_dot"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Status Tag ("CANCELLED") -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_status_cancelled"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="CANCELLED"
        android:textColor="@color/cancelled_text"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_route"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Book Again Button -->
    <LinearLayout
        android:id="@+id/btn_book_again"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_book_again"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_route"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Again"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Invoice Button -->
    <LinearLayout
        android:id="@+id/btn_invoice"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_btn_invoice"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/btn_book_again"
        app:layout_constraintTop_toTopOf="@id/btn_book_again"
        app:layout_constraintBottom_toBottomOf="@id/btn_book_again">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_invoice"
            app:tint="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invoice"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
